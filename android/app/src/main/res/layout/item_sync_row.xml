<?xml version="1.0" encoding="utf-8"?>
<!-- 同步面板里的一台电视：名字 + 说明 + 偏差 + 勾 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sync_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:gravity="center_vertical"
    android:minHeight="24dp"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sync_row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#EAF3FF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/sync_row_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="同一局域网 · 与整组偏差"
            android:textColor="#6F86A0"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/sync_row_dev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#4ADE80"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/sync_row_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="✓"
        android:textColor="#4ADE80"
        android:textSize="15sp" />
</LinearLayout>
