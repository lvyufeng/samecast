<?xml version="1.0" encoding="utf-8"?>
<!--
  电视端界面（播放页）：
  - 待机首页：品牌 + 设备名 + 投屏指引 + 网关连接状态
  - 播放中：只有画面（不打扰观看），按遥控器「确定」/「上」呼出底部控制栏
  - 底部控制栏：时间轴 + 快退/播放/快进/音量/同步/清晰度/更多
  - 面板：同步状态、清晰度、更多（画面比例）
  - 其余状态：缓冲、暂停、播放结束、无法播放、被其他投屏接管
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black" />

    <!-- ===== 待机首页 ===== -->
    <LinearLayout
        android:id="@+id/idle_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_idle"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="88dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:text="SameCast"
            android:textColor="#FFFFFF"
            android:textSize="62sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="同一部片，多台电视一起看"
            android:textColor="#7FA6C8"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/idle_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:textColor="#5F7488"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="等待手机投屏…"
            android:textColor="#E8F2FF"
            android:textSize="30sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="打开手机上的视频 App，点播放页右上角的「投屏」"
            android:textColor="#9FB4CC"
            android:textSize="21sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/AppChip"
                android:text="爱奇艺" />

            <TextView
                style="@style/AppChip"
                android:text="腾讯视频" />

            <TextView
                style="@style/AppChip"
                android:text="优酷" />

            <TextView
                style="@style/AppChip"
                android:text="哔哩哔哩" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="选择 SameCast，多台电视同步播放、同步暂停"
            android:textColor="#8FA3BF"
            android:textSize="19sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/gateway_dot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:background="@drawable/dot_warn" />

            <TextView
                android:id="@+id/gateway_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="正在查找 SameCast 网关…"
                android:textColor="#6F86A0"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#46586B"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ===== 缓冲中 ===== -->
    <LinearLayout
        android:id="@+id/loading_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/loading_spinner"
            style="?android:attr/progressBarStyle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="#7CE0FF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="正在缓冲…"
            android:textColor="#C9D6E6"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ===== 暂停 / 播放结束 / 无法播放 / 被其他投屏接管 ===== -->
    <LinearLayout
        android:id="@+id/overlay_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/overlay_icon"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_play_circle"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_play"
                android:tint="#06121F" />
        </FrameLayout>

        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="72dp"
            android:layout_marginEnd="72dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#F1F7FF"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/overlay_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="72dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="72dp"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:textColor="#9FB4CC"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ===== 左上角信息（控制栏可见时显示） ===== -->
    <LinearLayout
        android:id="@+id/top_info_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="32dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="32dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/top_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="#F1F7FF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/top_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_on" />

            <TextView
                android:id="@+id/top_sync_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#C9D6E6"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/top_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textColor="#4ADE80"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 底部控制栏 ===== -->
    <LinearLayout
        android:id="@+id/bottom_control_panel"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_scrim"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="22dp"
        android:paddingEnd="56dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/control_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#C9D6E6"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/control_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#C9D6E6"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="6dp">

            <View
                android:id="@+id/progress_track"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_progress_track" />

            <View
                android:id="@+id/progress_fill"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_progress_fill" />

            <View
                android:id="@+id/progress_thumb"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_progress_thumb" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btn_rewind"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="13dp"
                android:layout_marginEnd="13dp"
                android:background="@drawable/bg_control_focus"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_rewind10"
                    android:tint="@color/icon_tint" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_play"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="13dp"
                android:layout_marginEnd="13dp"
                android:background="@drawable/bg_control_focus"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_play_circle" />

                <ImageView
                    android:id="@+id/btn_play_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pause"
                    android:tint="#06121F" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_forward"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="13dp"
                android:layout_marginEnd="13dp"
                android:background="@drawable/bg_control_focus"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_forward10"
                    android:tint="@color/icon_tint" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_volume"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="13dp"
                android:layout_marginEnd="13dp"
                android:background="@drawable/bg_control_focus"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_volume"
                    android:tint="@color/icon_tint" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_sync"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="13dp"
                android:layout_marginEnd="13dp"
                android:background="@drawable/bg_control_focus"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_sync"
                    android:tint="@color/icon_tint" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_quality"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="13dp"
                android:layout_marginEnd="13dp"
                android:background="@drawable/bg_control_focus"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_quality"
                    android:tint="@color/icon_tint" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_more"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="13dp"
                android:layout_marginEnd="13dp"
                android:background="@drawable/bg_control_focus"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_more"
                    android:tint="@color/icon_tint" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="左右 选择按钮 · 确定 执行 · 下/返回 收起菜单 · 收起后全屏左右可快退/快进"
            android:textColor="#6F86A0"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ===== 同步状态面板 ===== -->
    <LinearLayout
        android:id="@+id/sync_panel"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="26dp"
        android:paddingEnd="30dp"
        android:paddingBottom="22dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="同步状态"
            android:textColor="#F1F7FF"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="整组锁定在同一条时间轴上，偏差过大时自动校正"
            android:textColor="#9FB4CC"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/sync_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/sync_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="没连上网关，暂时读不到整组状态"
            android:textColor="#FBBF24"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="刚接入的电视或缓冲过的电视，点「立即对齐」把整组拉回同一时刻"
            android:textColor="#6F86A0"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_resync"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_accent"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="立即对齐"
                android:textColor="#06121F"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_sync_close"
                android:layout_width="180dp"
                android:layout_height="44dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_btn_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="关闭"
                android:textColor="#DCE9F7"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="确定 执行 · 返回 关闭"
            android:textColor="#6F86A0"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ===== 清晰度面板 ===== -->
    <LinearLayout
        android:id="@+id/quality_panel"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="26dp"
        android:paddingEnd="30dp"
        android:paddingBottom="22dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="清晰度"
            android:textColor="#F1F7FF"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="自适应限制片源最高清晰度，所有电视一起切换"
            android:textColor="#9FB4CC"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/quality_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/quality_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="当前画面：--"
            android:textColor="#9FB4CC"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="手机投屏只有单码率时这里不生效，换清晰度请在手机 App 里切"
            android:textColor="#6F86A0"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="确定 切换 · 返回 关闭"
            android:textColor="#6F86A0"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ===== 更多面板（画面比例） ===== -->
    <LinearLayout
        android:id="@+id/more_panel"
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="26dp"
        android:paddingEnd="30dp"
        android:paddingBottom="22dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="更多"
            android:textColor="#F1F7FF"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="画面比例"
            android:textColor="#9FB4CC"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/more_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/more_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="#6F86A0"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="确定 切换 · 返回 关闭"
            android:textColor="#6F86A0"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ===== 音量提示 ===== -->
    <TextView
        android:id="@+id/volume_hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="300dp"
        android:background="@drawable/bg_hud"
        android:paddingStart="20dp"
        android:paddingTop="9dp"
        android:paddingEnd="20dp"
        android:paddingBottom="9dp"
        android:textColor="#DCE9F7"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- ===== 底部轻提示（控制栏上方） ===== -->
    <TextView
        android:id="@+id/toast_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="240dp"
        android:background="@drawable/bg_toast"
        android:paddingStart="18dp"
        android:paddingTop="9dp"
        android:paddingEnd="18dp"
        android:paddingBottom="9dp"
        android:textColor="#DCE9F7"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
